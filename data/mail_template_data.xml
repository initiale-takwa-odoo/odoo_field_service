<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- ✉️ MODÈLE D'EMAIL AUTOMATIQUE NETTOYÉ ET TRADUISIBLE POUR ODOO 19 -->
        <record id="email_template_field_service" model="mail.template">
            <field name="name">Services Terrain : Envoi Fiche d'Intervention</field>
            <field name="model_id" ref="model_field_service"/>
            <field name="subject">Fiche d'intervention {{ object.code }}</field>
            <field name="email_to">{{ object.partner_id.email }}</field>
            
                <!-- <field name="lang">{{ user.lang }}</field>
                 <field name="lang">{{ object.partner_id.lang }}</field>  -->


            <field name="description">Modèle d'envoi automatique de la fiche technique validée</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px; font-family: 'Segoe UI', sans-serif;">
                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
                        Bonjour,<br/><br/>
                        Nous vous informons que votre intervention a été clôturée avec succès.<br/><br/>
                        Vous trouverez en pièce jointe de cet email votre <strong>Fiche d'Intervention officielle</strong> validée par notre technicien.<br/><br/>
                        Cordialement,<br/>
                        L'équipe technique
                    </p>
                </div>
            </field>
            <!-- 🌟 PIÈCE JOINTE ODOO 19 -->
            <field name="report_template_ids" eval="[(4, ref('action_report_field_service'))]"/>
        </record>
    </data>
</odoo>
