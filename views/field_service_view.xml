<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- 1. LA VUE LISTE (TABLEAU) -->
         <record id="view_field_service_tree" model="ir.ui.view">
            <field name="name">field.service.tree</field>
            <field name="model">field.service</field>
            <field name="arch" type="xml">
                <list string="Interventions">
                    <field name="priority" widget="priority" nolabel="1"/>
                    <field name="partner_id"/>
                    <field name="name"/> 
                    <field name="name1"/> 
                    <field name="code" string="N° Interv." class="fw-bold"/>
                    <!-- 🌟 SÉCURISATION DES BADGES DE COULEUR POUR ODOO 19 -->
                    <field name="category" widget="badge" decoration-success="category == 'ins'" decoration-info="category == 'ec'" decoration-danger="category == 'du'" decoration-warning="category == 'R'"/>
                    <field name="day"/>
                    <field name="time_slot"/>
                    <field name="deadline"/> 
                    <!-- 🌟 LA CORRECTION ABSOLUE : Force Odoo à enregistrer le statut lors de la sauvegarde -->
                    <!-- 🌟 AFFICHAGE ÉPURÉ : Un simple badge textuel au lieu du grand workflow complet -->
                    <field name="state" widget="badge" decoration-muted="state == 'draft'" decoration-warning="state in ['in_progress', 'paused']" decoration-success="state == 'done'"/>
                </list>
            </field>
        </record>

        <!-- 2. LA VUE KANBAN MODERNE ODOO 19 AVEC AVATARS -->
        <record id="view_field_service_kanban" model="ir.ui.view">
            <field name="name">field.service.kanban</field>
            <field name="model">field.service</field>
            <field name="arch" type="xml">
                <!-- 🌟 VUE KANBAN ADAPTATIVE (Mobiles + Tablettes) -->
                <kanban default_group_by="state" class="o_kanban_mobile" sample="1" quick_create="false">

                    <field name="is_done"/>
                    <field name="category"/>
                    <field name="partner_id"/>
                    <field name="state"/>
                    <templates>
                        <t t-name="card">
                            <div class="oe_kanban_global_click p-3 mb-2 rounded shadow-sm border-start border-4"
                                 t-attf-class="{{ record.is_done.raw_value ? 'border-success bg-light opacity-75' : 'border-primary bg-white' }}">
                                
                                <div class="o_kanban_record_top mb-1 d-flex justify-content-between align-items-start">
                                    <h4 class="o_kanban_record_title fw-bold m-0">
                                        <field name="name"/>
                                    </h4>
                                    <button name="unlink" type="object" icon="fa-trash" class="text-muted hover-danger border-0 bg-transparent p-0" confirm="Supprimer définitivement cette intervention ?"/>
                                </div>

                                <div class="o_kanban_record_body small mb-2 text-muted">
                                    <i class="fa fa-clock-o me-1"/> <field name="time_slot"/><br/>
                                    👤 <field name="partner_id"/>
                                </div>

                                <div class="o_kanban_record_bottom d-flex justify-content-between align-items-center mt-3 pt-2 border-top">
                                    <field name="priority" widget="priority"/> 
                                    <field name="state" widget="label_selection" options="{'classes': {'draft': 'default', 'in_progress': 'warning', 'paused': 'info', 'done': 'success'}}"/>
                                    
                                    <!-- Avatar dynamique Odoo 19 -->
                                    <div t-if="record.partner_id.raw_value">
                                        <img t-attf-src="/web/image/res.partner/{{record.partner_id.raw_value}}/avatar_128" class="rounded-circle border" style="width: 26px; height: 26px; object-fit: cover;" alt="Client"/>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- 3. LA VUE GRAPHIQUE (ANALYSE DES CHANTIERS) -->
        <!-- 🌟 LA VUE GRAPHIQUE FINANCIÈRE ET COLORÉE POUR LE PORTFOLIO -->
        <record id="view_field_service_graph" model="ir.ui.view">
            <field name="name">field.service.graph</field>
            <field name="model">field.service</field>
            <field name="arch" type="xml">
                <!-- sample="1" ajoute des animations fluides et de superbes dégradés de couleurs -->
                <graph string="Analyse des Interventions" type="bar" sample="1">
                    <!-- L'axe X (le bas) sera découpé par Type d'Intervention -->
                    <field name="category" type="row"/>
                    <!-- 💰 LA MESURE FINANCIÈRE : Le graphique affichera la hauteur des gains en Euros ! -->
                    <field name="price_subtotal" type="measure"/>
                </graph>
            </field>
        </record>

                <!-- 🌟 LA VUE PIVOT ANALYTIQUE (TABLEAU CROISÉ DYNAMIQUE) -->
        <!-- 🌟 LA VUE PIVOT FINANCIÈRE AVEC MESURE DE CHIFFRE D'AFFAIRES -->
 <!-- 🌟 VOTRE VUE PIVOT AVEC FEU DE CHALEUR PAR WIDGET COLORÉ -->
            <!-- 🌟 LA VUE PIVOT FINANCIÈRE NETTOYÉE ET SANS ERREUR -->
        <record id="view_field_service_pivot" model="ir.ui.view">
            <field name="name">field.service.pivot</field>
            <field name="model">field.service</field>
            <field name="arch" type="xml">
                <pivot string="Analyse des Interventions" sample="1">
                    <!-- Les lignes : Découpées par Type d'Intervention -->
                    <field name="category" type="row"/>
                    <!-- Les colonnes : Découpées par Jour -->
                    <field name="day" type="col"/>
                    <!-- La mesure brute pour éviter les conflits de widgets multi-devises -->
                    <field name="price_subtotal" type="measure"/>
                </pivot>
            </field>
        </record>




        <!-- 4. LA VUE RECHERCHE ODOO 19 -->
        <record id="view_field_service_search" model="ir.ui.view">
            <field name="name">field.service.search</field>
            <field name="model">field.service</field>
            <field name="arch" type="xml">
                <search string="Rechercher des interventions">
                    <field name="name" string="Titre"/>
                    <field name="partner_id" string="Client"/>
                    <filter string="🚨 Urgences" name="urgent" domain="[('priority', '=', '1')]"/>
                    <filter string="🛠️ En Cours" name="progress" domain="[('state', '=', 'in_progress')]"/>
                    <filter string="⏸️ En Pause" name="paused" domain="[('state', '=', 'paused')]"/>
                    <separator/>
                    <filter string="👤 Regrouper par Client" name="group_by_partner" context="{'group_by': 'partner_id'}"/>
                    <filter string="🗂️ Regrouper par Métier" name="group_by_category" context="{'group_by': 'category'}"/>
                </search>
            </field>
        </record>

        <!-- 5. LA VUE FORMULAIRE -->
        <record id="view_field_service_form" model="ir.ui.view">
             <field name="name">field.service.form</field>
             <field name="model">field.service</field>
             <field name="arch" type="xml">
                 <form string="Gestion de l'Intervention">
                                        <header>
                        <!-- 1. Démarrer (Brouillon) -->
                        <button name="action_start_task" string="Démarrer le chantier 🛠️" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                        
                        <!-- 2. Mettre en Pause (En Cours) -->
                        <button name="action_paused_task" string="Mettre en Pause ⏸️" type="object" class="btn-warning" invisible="state != 'in_progress'"/>
                        
                        <!-- 3. Reprendre (En Pause) -->
                        <button name="action_resume_task" string="Reprendre le chantier ▶️" type="object" class="oe_highlight" invisible="state != 'paused'"/>
                        
                        <!-- 4. 🌟 LE BOUTON VALIDER (Visible uniquement si En cours ou En pause) -->
                        <button name="action_complete_task" string="Clôturer l'Intervention ✅" type="object" class="btn-success" invisible="state not in ['in_progress', 'paused']"/>
                        
                        <!-- 5. 🔄 LE BOUTON REVENIR EN ARRIÈRE (Visible uniquement si Terminé) -->
                        <button name="action_cancel_completion" string="Rouvrir l'intervention 🔓" type="object" class="btn-secondary" invisible="state != 'done'"/>
                       
                        <!-- 6. ✉️ BOUTON ENVOYER PAR EMAIL (Visible uniquement si Terminé) -->
                        <button name="action_send_intervention_email" string="Envoyer la fiche par Email ✉️" type="object" class="btn-primary" invisible="state != 'done'"/>

                        <!-- La barre d'état graphique à droite -->
                        <field name="state" widget="statusbar" statusbar_visible="draft,in_progress,paused,done"/>
                    </header>



                    <sheet>
                        <widget name="web_ribbon" title="Terminé 🎉" bg_color="text-bg-success" invisible="not is_done"/>
                        <!-- 🔢 AFFICHAGE DU NUMÉRO UNIQUE EN GRAND -->
                        <div class="oe_title mb-4">
                            <h1>
                                <field name="code" readonly="1"/>
                            </h1>
                        </div>
                        <!-- 🌟 FORCE L'EMPILAGE VERTICAL SUR SMARTPHONE ET DEUX COLONNES SUR PC -->
                        <group col="2">
                            <group string="Planification">
                              <field name="day"/>
                              <field name="time_slot"/>
                              <field name="start_datetime"/>
                              <field name="name1"/>
                              <field name="category"/>
                              <!-- 🌟 CHAMP SOCIÉTÉ VISIBLE (Avec sélection rapide) -->
                              <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}"/>
                              <field name="priority" widget="priority"/>
                            </group>
                            <group string="Détails Client">
                              <field name="name"/>
                              <field name="partner_id"/> 
                              <field name="partner_phone" widget="phone"/> 
                              <field name="partner_email" widget="email"/> 
                              <field name="deadline"/>
                              <!-- 🌟 AFFICHAGE DU MONTANT FINANCIER AVEC LE SYMBOLE MONÉTAIRE AUTOMATIQUE -->
                              <!-- 🌟 ON REND LA CASE DEVISE VISIBLE POUR LE CHOIX DE L'ARTISAN -->
                              <field name="currency_id" options="{'no_create': True, 'no_open': True}"/>
                              <field name="price_subtotal" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                              <field name="is_done" string="Chantier Clôturé ?"/>
                            </group>
                        </group>
                        
                        <group string="Ma Check-list / Étapes Techniques" invisible="state == 'draft'">
                             <field name="subtask_ids" nolabel="1" widget="one2many">
                                <list editable="bottom">
                                    <field name="name" placeholder="Ex: Remplacer le joint, Tester la pression..."/>
                                    <field name="is_done"/>
                                </list>
                             </field>
                        </group>
                        
                        <group string="Rapport d'Intervention Fin de Chantier">
                               <field name="worker_comment" placeholder="Tapez ici vos remarques techniques pour le client..." nolabel="1"/>
                        </group>
                    </sheet>
                    
                    <!-- 🌟 LE CHATTER PARFAITEMENT ISOLÉ ET NETTOYÉ POUR ODOO 19 -->                 
                    <!-- 🌟 LA BALISE UNIQUE ET SÉCURISÉE POUR LE CHATTER ODOO -->
                    <chatter/>
                    
                </form>
             </field>
        </record>


        <!-- 6. L'ACTION PRINCIPALE MIS À JUOR -->
        <record id="action_field_service" model="ir.actions.act_window">
            <field name="name">Mon Gestionnaire Terrain</field>
            <field name="res_model">field.service</field>
            <field name="view_mode">list,kanban,graph,pivot,form</field>
            <field name="search_view_id" ref="view_field_service_search"/>
        </record>

        <!-- 7. LES MENUS -->
        <menuitem id="menu_service_root" name="Services Terrain 🛠️" sequence="10"/>
        <menuitem id="menu_field_service" name="Interventions" parent="menu_service_root" action="action_field_service" sequence="10"/>
    </data>
</odoo>
