<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- 🛡️ LA RÈGLE DE SÉCURITÉ MULTI-SOCIÉTÉS (RECORD RULE) -->
        <record id="rule_field_service_multi_company" model="ir.rule">
            <field name="name">Interventions : Filtre Multi-Sociétés</field>
            <field name="model_id" ref="model_field_service"/>
            <field name="global" eval="True"/>
            <!-- 🔗 La formule magique Odoo 19 qui compare la société du chantier et celle de l'utilisateur -->
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
